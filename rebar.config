%% -*- mode: erlang -*-
%% 打包依赖：emqx_plugin_helper（EMQX 插件运行时辅助，进 release）、
%%           emqx_plugrel（打包插件，`rebar3 emqx_plugrel tar` 产出 .tar.gz）、
%%           epgsql（PostgreSQL 客户端，本插件写库用）
{deps, [
    {emqx_plugin_helper, {git, "https://github.com/emqx/emqx-plugin-helper.git", {tag, "v5.9.1"}}},
    {epgsql, "4.7.1"}
]}.

{plugins, [
    {emqx_plugrel, {git, "https://github.com/emqx/emqx_plugrel.git", {tag, "0.6.3"}}}
]}.

{erl_opts, [debug_info]}.

%% 从 relx release 版本号生成 VERSION 文件（模板自带；仅 linux/darwin 生效，Windows 上自动跳过）
{pre_hooks, [
    {"(linux|darwin)", compile,
        "erl -noshell -eval '{ok, Terms} = file:consult(\"rebar.config\"), "
        "{relx, Relx} = lists:keyfind(relx, 1, Terms), "
        "{release, {_, Vsn}, _} = lists:keyfind(release, 1, Relx), "
        "ok = file:write_file(\"VERSION\", [Vsn, $\\n]), "
        "halt().'"}
]}.

%% 插件 release：只打包插件本体与 emqx_plugin_helper（EMQX 运行时自带 kernel/stdlib/emqx）
{relx, [
    {release, {emqx_pg_ingest, "0.1.0"}, [
        emqx_pg_ingest,
        emqx_plugin_helper
    ]},
    {dev_mode, false},
    {include_erts, false},
    {include_src, false}
]}.

%% 写进插件 manifest.json（EMQX 控制台会展示）
{emqx_plugrel, [
    {authors, ["wangcw"]},
    {builder, [
        {name, "wangcw"},
        {contact, "rubygreat@msn.com"},
        {website, "https://github.com/redgreat"}
    ]},
    {repo, "https://github.com/redgreat/agentwong"},
    {functionality, ["MQTT binary RaceBox/BMS ingest", "PostgreSQL writer with configurable SQL"]},
    {compatibility, [{emqx, "~> 5.7"}]},
    {description, "EMQX plugin: decode binary RaceBox/BMS messages from MQTT topics and insert into PostgreSQL (topics and SQL fully configurable)."}
]}.

{eunit_opts, [verbose]}.

